# Copy this file to `.streamlit/secrets.toml` for LOCAL runs (it is gitignored),
# OR paste the same contents into Streamlit Cloud -> App -> Settings -> Secrets.
# Do NOT commit the real secrets.toml to GitHub.

[salesforce]
client_id = "YOUR_CONNECTED_APP_CONSUMER_KEY"
client_secret = "YOUR_CONNECTED_APP_CONSUMER_SECRET"
# Must EXACTLY match the Callback URL in your Salesforce Connected App.
# Local:  http://localhost:8501
# Cloud:  https://YOUR-APP-NAME.streamlit.app
redirect_uri = "https://YOUR-APP-NAME.streamlit.app"
auth_host = "https://cvest.my.salesforce.com"
